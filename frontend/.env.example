# API base path. In development Vite proxies /api to http://localhost:8080 (vite.config.ts).
# In production (Vercel) set the full backend URL, e.g. https://unikompas-api.onrender.com/api/v1
VITE_API_BASE_URL=/api/v1

# Show demo credentials under the login form (public portfolio deployment only)
VITE_SHOW_DEMO_HINT=false
